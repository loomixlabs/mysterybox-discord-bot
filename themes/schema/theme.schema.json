{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bot-discord.local/schemas/theme.schema.json",
  "title": "Theme Configuration",
  "description": "Schema de validation pour les fichiers de configuration de thèmes (.theme.json)",
  "type": "object",
  "required": ["version", "metadata", "theme"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version du format de fichier (semver)"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "description", "author"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 50,
          "description": "Nom d'affichage du thème"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Description du thème"
        },
        "author": {
          "type": "string",
          "description": "Créateur du thème"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tags pour la recherche"
        },
        "preview_image": {
          "type": "string",
          "format": "uri",
          "description": "Image de prévisualisation (deprecated, use banner_url)"
        },
        "banner_url": {
          "type": "string",
          "format": "uri",
          "description": "URL de la bannière du thème (1200x400 recommandé)"
        },
        "thumbnail_url": {
          "type": "string",
          "format": "uri",
          "description": "URL de la miniature du thème (400x400 recommandé)"
        },
        "icon": {
          "type": "string",
          "maxLength": 10,
          "description": "Emoji icône du thème"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Date de création"
        },
        "exported_from": {
          "type": "string",
          "description": "Guild ID source (pour les exports)"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["theme_id", "name", "duration_days", "required_items", "final_role_name", "final_role_color"],
      "additionalProperties": false,
      "properties": {
        "theme_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 3,
          "maxLength": 50,
          "description": "Identifiant unique du thème (lowercase, underscores)"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Nom d'affichage du thème"
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "Durée du thème en jours"
        },
        "required_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Nombre d'items requis pour compléter la collection"
        },
        "final_role_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Nom du rôle de complétion"
        },
        "final_role_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Couleur du rôle (hex)"
        }
      }
    },
    "theme_config": {
      "type": "object",
      "additionalProperties": true,
      "description": "Configuration des probabilités, messages et rôles de progression",
      "properties": {
        "probability_collectible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 40,
          "description": "% de chance d'obtenir un collectible (total des 4 types = 100)"
        },
        "probability_mission": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 30,
          "description": "% de chance de déclencher une mission (total des 4 types = 100)"
        },
        "probability_trap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "description": "% de chance de déclencher un piège (total des 4 types = 100)"
        },
        "probability_super_bonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 10,
          "description": "% de chance d'obtenir un super bonus (total des 4 types = 100)"
        },
        "collectible_rarity_legendary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 5
        },
        "collectible_rarity_epic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 10
        },
        "collectible_rarity_rare": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20
        },
        "collectible_rarity_common": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 40
        },
        "super_bonus_rarity_legendary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 5
        },
        "super_bonus_rarity_epic": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 10
        },
        "super_bonus_rarity_rare": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20
        },
        "super_bonus_rarity_common": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 40
        },
        "mystery_box_image": {
          "type": "string",
          "format": "uri"
        },
        "mystery_box_title": {
          "type": "string",
          "default": "BOITE MYSTERIEUSE"
        },
        "mystery_box_description": {
          "type": "string",
          "default": "Que contient-elle ?"
        },
        "mystery_box_winner_message": {
          "type": "string",
          "default": "{player} a ouvert la boite mystere !"
        },
        "mystery_box_celebration_gif": {
          "type": "string",
          "format": "uri"
        },
        "mystery_box_celebration_emojis": {
          "type": "string",
          "default": ",,"
        },
        "auto_delete_celebration_message": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "collectibles": {
      "type": "array",
      "minItems": 1,
      "description": "Liste des collectibles du thème",
      "items": {
        "type": "object",
        "required": ["collectible_id", "name", "image_url", "rarity"],
        "additionalProperties": false,
        "properties": {
          "collectible_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "Identifiant unique du collectible"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Nom d'affichage"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "URL de l'image"
          },
          "rarity": {
            "type": "string",
            "enum": ["common", "rare", "epic", "legendary"],
            "description": "Rareté du collectible"
          },
          "reveal_message": {
            "type": "string",
            "maxLength": 500,
            "description": "Message personnalisé lors de l'obtention"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Description du collectible"
          }
        }
      }
    },
    "traps": {
      "type": "array",
      "description": "Liste des pièges du thème",
      "items": {
        "type": "object",
        "required": ["trap_id", "name", "type", "description"],
        "additionalProperties": false,
        "properties": {
          "trap_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "Identifiant unique du piège"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Nom d'affichage"
          },
          "type": {
            "type": "string",
            "enum": ["cooldown", "lose-collectible", "lose-all-collectibles", "public-shame", "empty-box"],
            "description": "Type d'effet du piège"
          },
          "description": {
            "type": "string",
            "description": "Description du piège"
          },
          "image_url": {
            "type": "string",
            "format": "uri"
          },
          "cooldown_duration": {
            "type": "integer",
            "minimum": 0,
            "description": "Durée du cooldown en secondes (pour type cooldown)"
          },
          "reveal_message": {
            "type": "string",
            "description": "Message affiché lors du déclenchement du piège"
          },
          "removes_collectible": {
            "type": "boolean",
            "default": false
          },
          "shame_message": {
            "type": "string",
            "description": "Message de honte (pour type public-shame)"
          },
          "is_default": {
            "type": "boolean",
            "default": false
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "notif_title": {
            "type": "string"
          },
          "notif_description": {
            "type": "string"
          },
          "notif_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "default": "#e74c3c"
          },
          "notif_footer": {
            "type": "string"
          }
        }
      }
    },
    "missions": {
      "type": "object",
      "description": "Missions par type",
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "type": "array",
          "description": "Missions de type mot-clé",
          "items": {
            "type": "object",
            "required": ["mission_id", "name", "description", "keywords"],
            "additionalProperties": false,
            "properties": {
              "mission_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string"
              },
              "timeout": {
                "type": "integer",
                "minimum": 10,
                "maximum": 3600,
                "default": 60
              },
              "image_url": {
                "type": "string",
                "format": "uri"
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["keyword"],
                  "properties": {
                    "keyword": {
                      "type": "string",
                      "minLength": 1
                    },
                    "difficulty": {
                      "type": "string",
                      "enum": ["easy", "medium", "hard"],
                      "default": "medium"
                    }
                  }
                }
              }
            }
          }
        },
        "quiz": {
          "type": "array",
          "description": "Missions de type quiz",
          "items": {
            "type": "object",
            "required": ["mission_id", "name", "description", "questions"],
            "additionalProperties": false,
            "properties": {
              "mission_id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string"
              },
              "timeout": {
                "type": "integer",
                "minimum": 10,
                "maximum": 3600,
                "default": 60
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "image_url": {
                "type": "string",
                "format": "uri"
              },
              "questions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["question_text", "correct_answer"],
                  "properties": {
                    "question_text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "correct_answer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "answers": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Toutes les réponses possibles (incluant la correcte)"
                    },
                    "wrong_answers": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "hint": {
                      "type": "string"
                    },
                    "difficulty": {
                      "type": "string",
                      "enum": ["easy", "medium", "hard"],
                      "default": "medium"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "theme_messages": {
      "type": "object",
      "description": "Messages personnalisés par clé",
      "additionalProperties": {
        "type": "string"
      }
    },
    "announcement_templates": {
      "type": "object",
      "description": "Templates d'annonces personnalisés. 18 types système disponibles. Variables: {userName}, {collectibleName}, {missionName}, {trapName}, {themeName}, {roleName}, {bonusName}, {bonusIcon}, {word}, {timeLimit}, {rewardName}, {failReason}, {adminName}, {durationDays}, {expirationDate}, {daysRemaining}, {duration}, {collectible}, {user1Name}, {user2Name}",
      "additionalProperties": false,
      "properties": {
        "legendary_collectible": {
          "type": "string",
          "description": "Annonce obtention collectible légendaire. Variables: {userName}, {collectibleName}"
        },
        "collection_completed": {
          "type": "string",
          "description": "Annonce collection complétée. Variables: {userName}, {themeName}, {roleName}"
        },
        "collection_traded": {
          "type": "string",
          "description": "Annonce échange de collection. Variables: {user1Name}, {user2Name}, {missionName}"
        },
        "collection_lost": {
          "type": "string",
          "description": "Annonce collectible perdu par piège. Variables: {userName}, {trapName}"
        },
        "trap_cooldown": {
          "type": "string",
          "description": "Annonce piège de type cooldown. Variables: {userName}, {trapName}, {duration}"
        },
        "trap_lose_collectible": {
          "type": "string",
          "description": "Annonce piège perte d'un collectible. Variables: {userName}, {trapName}, {collectible}"
        },
        "trap_public_shame": {
          "type": "string",
          "description": "Annonce piège honte publique. Variables: {userName}, {trapName}"
        },
        "trap_empty_box": {
          "type": "string",
          "description": "Annonce piège boîte vide. Variables: {userName}, {trapName}"
        },
        "trap_lose_all_collectibles": {
          "type": "string",
          "description": "Annonce piège perte totale. Variables: {userName}, {trapName}"
        },
        "mission_word_guessed": {
          "type": "string",
          "description": "Annonce mot deviné (mission keyword). Variables: {userName}, {word}, {missionName}"
        },
        "mission_started": {
          "type": "string",
          "description": "Annonce mission commencée. Variables: {userName}, {missionName}, {timeLimit}"
        },
        "mission_completed": {
          "type": "string",
          "description": "Annonce mission réussie. Variables: {userName}, {missionName}, {rewardName}"
        },
        "mission_failed": {
          "type": "string",
          "description": "Annonce mission échouée. Variables: {userName}, {missionName}, {failReason}"
        },
        "mission_approved": {
          "type": "string",
          "description": "Annonce mission approuvée par admin. Variables: {userName}, {missionName}, {adminName}, {rewardName}"
        },
        "mission_rejected": {
          "type": "string",
          "description": "Annonce mission rejetée par admin. Variables: {userName}, {missionName}, {adminName}"
        },
        "theme_expiring_soon": {
          "type": "string",
          "description": "Annonce expiration prochaine. Variables: {themeName}, {daysRemaining}, {expirationDate}"
        },
        "theme_expired": {
          "type": "string",
          "description": "Annonce thème expiré. Variables: {themeName}, {durationDays}, {expirationDate}"
        },
        "legendary_super_bonus": {
          "type": "string",
          "description": "Annonce super bonus obtenu. Variables: {userName}, {bonusName}, {bonusIcon}"
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Options d'import et de comportement",
      "additionalProperties": true,
      "properties": {
        "auto_create_roles": {
          "type": "boolean",
          "default": true,
          "description": "Créer automatiquement le rôle de complétion"
        },
        "auto_install_super_bonuses": {
          "type": "boolean",
          "default": true,
          "description": "Installer les 11 super bonus disponibles (4 entièrement implémentés)"
        },
        "activate_theme_after_import": {
          "type": "boolean",
          "default": false,
          "description": "Activer le thème immédiatement après import"
        }
      }
    }
  }
}
