# ========================================
# DISCORD BOT - Configuration Template
# ========================================
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# ==================== Discord Configuration ====================
# Token du bot Discord (obtenu sur https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ID de l'application Discord
APPLICATION_ID=your_application_id_here

# ID du serveur de test (pour les commandes guild-specific)
GUILD_ID=your_test_guild_id_here

# ==================== Base de Données PostgreSQL ====================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://botuser:your_password@localhost:5432/botdb

# ==================== Permissions ====================
# ID du rôle "Co-Fondateur" ayant accès aux commandes admin
CO_FOUNDER_ROLE_ID=your_cofounder_role_id_here

# ==================== Salons Discord ====================
# ID du salon d'annonces
ANNOUNCE_CHANNEL_ID=your_announcement_channel_id_here

# ID de la catégorie pour les gives
GIVE_CATEGORY_ID=your_give_category_id_here

# ==================== Super Admin ====================
# ID Discord du propriétaire du bot (accès complet)
OWNER_DISCORD_ID=your_discord_user_id_here

# ==================== Optional: VPS Configuration ====================
# Configuration pour le déploiement sur VPS (optionnel)
# VPS_HOST=your_vps_ip_or_domain
# VPS_USER=your_vps_username
# VPS_PATH=/path/to/bot/on/vps

# ==================== Optional: Environment ====================
# Environnement d'exécution (development, production)
# NODE_ENV=development
